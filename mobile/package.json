{
  "name": "collective-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Operator surface for mobile.opencollective.app",
  "scripts": {
    "predev": "node ../scripts/sync-vendor-core.mjs mobile || true",
    "dev": "next dev --port 3002",
    "prebuild": "node ../scripts/sync-vendor-core.mjs mobile || true",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "verify:no-v2": "node scripts/assert-no-v2.mjs",
    "axe:report": "node scripts/axe-report.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.27.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.0.5"
  }
}
